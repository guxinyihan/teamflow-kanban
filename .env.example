# Run the backend from backend/. Copy this file to backend/.env.
DATABASE_URL=sqlite:///./kanban.db
# Generate a random value: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=30
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=private_uploads
MAX_UPLOAD_BYTES=10485760
INVITE_HOURS=48
